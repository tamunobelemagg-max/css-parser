parser: NodeJS with Webpack

on:
  push: css-parser
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs: maintenance 
  build:
    runs-on: ubuntu-latest

    strategy:
      matrix:
        node-version: [18.x, 20.x, 22.x]

    steps:## 500101
    - uses: actions/checkout@v4

    - name: Use Node.js ${{ matrix.node-version }}
      uses: actions/setup-node@v4
      with:
        node-version: ${{ matrix.node-version }}

    - name: Build
      run: |
        npm install
        npx webpack
